FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 agenthub \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin agenthub \
    && mkdir -p /app/data /app/backups /run/agenthub \
    && chown -R 10001:10001 /app /run/agenthub

WORKDIR /app
COPY pyproject.toml requirements.txt ./
COPY src ./src
COPY deploy ./deploy
COPY alembic.ini ./
RUN pip install --no-cache-dir .

USER 10001:10001
EXPOSE 8000
